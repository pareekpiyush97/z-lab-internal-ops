# --- Database (Supabase Postgres) ---
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI.
# Use the POOLED connection (port 6543, "Transaction" mode, includes
# ?pgbouncer=true) if deploying to a serverless platform like Vercel; use the
# direct connection (port 5432) for a traditional always-on Node server.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.efyyugigeqekyvywnacp.supabase.co:5432/postgres"

# --- Session security ---
# Generate with: openssl rand -base64 48
# MUST be a long random secret in production. Rotating it invalidates all sessions.
SESSION_SECRET="replace-with-a-long-random-string"

# --- Seed / first admin account ---
# Used only by `npm run db:seed`. Change the password immediately after first login.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-this-before-seeding"

# --- Admin sign-in: "Sign in with Google" ---
# Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials
# -> OAuth client ID -> Application type: Web application.
# Authorized redirect URIs must include, for every environment you run this in:
#   http://localhost:3000/api/admin/auth/google/callback   (local dev)
#   https://<your-deployed-domain>/api/admin/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Two comma-separated allowlists -- Google only proves *who* signed in;
# these decide *what* they can see once inside. Anyone signing in with a
# Google account on neither list is turned away outright.
#   Owner:  full access -- P&L, stock purchases, reminders, leads,
#           services, gallery, business settings, plus everything staff has.
#   Staff:  shop-floor only -- Jobs, Stock & Logistics, Service History.
ALLOWED_OWNER_EMAILS="your-zlabs-email@gmail.com"
ALLOWED_STAFF_EMAILS=""

# --- Business / WhatsApp (deep-link mode, no API keys needed) ---
BUSINESS_WHATSAPP_NUMBER="919910503232"

# --- Phase 2 (add after main project is complete): WhatsApp Business API ---
# Leave blank for now. See README "Roadmap" section for setup steps.
# WHATSAPP_BUSINESS_API_TOKEN=
# WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_VERIFY_TOKEN=

# --- Future integration: fixed-camera plate recognition ---
# Leave blank until that phase begins. See README "Roadmap" section.
# PLATE_RECOGNITION_WEBHOOK_SECRET=
